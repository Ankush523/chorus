# Public site URL (must match your deployed domain for Anthropic application)
NEXT_PUBLIC_SITE_URL=https://getaccord.com

# Contact email shown on site and privacy page (same domain as URL)
NEXT_PUBLIC_CONTACT_EMAIL=hello@getaccord.com

# Optional: forward waitlist submissions (required on Vercel — filesystem is read-only)
WAITLIST_WEBHOOK_URL=
